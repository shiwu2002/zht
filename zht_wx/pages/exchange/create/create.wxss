/* pages/exchange/create.wxss */
.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.char-count {
  font-size: 22rpx;
  color: #999;
}

/* 选择器 */
.item-selector {
  min-height: 140rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
}

.empty-text {
  color: #999;
  font-size: 26rpx;
}

.selected-item {
  display: flex;
  align-items: center;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.5;
  font-size: 48rpx;
  line-height: 32rpx;
  color: #999;
  text-align: center;
}

/* 物品详情框 */
.item-detail-box {
  display: flex;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

/* 留言 */
.message-input {
  width: 100%;
  min-height: 180rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
