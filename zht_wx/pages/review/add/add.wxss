/* pages/review/add.wxss */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 交换信息卡片 */
.exchange-info {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-header {
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e0e0e0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-nickname {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.user-item {
  font-size: 26rpx;
  color: #999;
}

/* 评分区域 */
.rating-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.rating-stars {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.star {
  font-size: 48rpx;
  color: #e0e0e0;
  transition: all 0.3s;
}

.star.active {
  color: #ff9800;
}

.rating-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 20rpx;
}

/* 评价内容区域 */
.comment-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  position: relative;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.char-count {
  font-size: 24rpx;
  color: #999;
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
}

/* 快捷标签区域 */
.tags-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tag.selected {
  background: #07c160;
  color: #ffffff;
}

/* 提交按钮 */
.submit-section {
  padding: 20rpx 0;
}

.submit-btn {
  width: 100%;
  background: #07c160;
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  transition: all 0.3s;
}

.submit-btn:disabled {
  background: #cccccc;
  color: #999999;
}

.submit-btn:not(:disabled):active {
  opacity: 0.8;
  transform: scale(0.98);
}
